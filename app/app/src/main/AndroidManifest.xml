<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.usb.host" android:required="true" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 导航 HUD：把解析后的导航 JSON 推到 Pi（Wi-Fi 同网段） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 导航 HUD：读 Google 地图的导航通知（用户在系统里授权「通知使用权」） -->
    <uses-permission android:name="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE" />
    <!-- UVC 设备（眼镜摄像头）需要 CAMERA 权限才会授予 USB 访问 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 眼镜麦克风（UAC）录音 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 音量控制（AudioManager.STREAM_MUSIC 加减） -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <application
        android:name=".GlxssApp"
        android:allowBackup="true"
        android:label="GLXSS3 Cast"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>

        <service
            android:name=".cast.CastService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- 息屏遮罩：全屏纯黑 + 窗口亮度 0。只在「单个应用」抓取时用，否则黑遮罩会被一起抓走。
             screenOrientation="locked"：不把显示方向从横屏掰回竖屏（否则被抓的 App 会 resize）。 -->
        <activity
            android:name=".cast.BlackoutActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:screenOrientation="locked"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode"
            android:theme="@style/Theme.Blackout" />

        <!-- 导航 HUD：解析 Google 地图导航通知（需要「通知使用权」） -->
        <service
            android:name=".nav.NavListenerService"
            android:exported="true"
            android:label="GLXSS3 导航 HUD"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 实验/取证入口：exported=false，只能用 root shell 的 am broadcast 显式组件调用 -->
        <receiver
            android:name=".diag.DebugReceiver"
            android:exported="false" />
    </application>
</manifest>


