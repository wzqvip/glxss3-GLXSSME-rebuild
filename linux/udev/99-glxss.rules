# /etc/udev/rules.d/99-glxss.rules
# 亮亮视野 GLXSS3/G25：正常模式 2e09:0030、Myriad 引导模式 03e7:2150
# 安装：
#   sudo cp linux/udev/99-glxss.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#
# 0666 适合无桌面的树莓派；有桌面时可用 TAG+="uaccess" 只授予当前登录用户。
SUBSYSTEM=="usb", ATTR{idVendor}=="2e09", ATTR{idProduct}=="0030", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="03e7", ATTR{idProduct}=="2150", MODE="0666", TAG+="uaccess"
