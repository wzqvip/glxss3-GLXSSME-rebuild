[Unit]
Description=GLXSS G25 UVC → RTSP 直播（720p30，Fn 可切眼镜预览）
Documentation=file:/home/taco/glxss3-linux/pi/STREAM.md
After=network-online.target mediamtx.service
Wants=network-online.target
# 设备没插时 glxss-stream 会每 15 s 重试，不要因为启动顺序失败就放弃
StartLimitIntervalSec=0

[Service]
Type=simple
User=taco
Group=taco
SupplementaryGroups=video
WorkingDirectory=/home/taco/glxss3-linux
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/taco/glxss3-linux
# 控制 socket 固定到 /run/glxss；glxss ctl --socket /run/glxss/glxssctl.sock 连
Environment=GLXSS_SOCK=/run/glxss/glxssctl.sock
RuntimeDirectory=glxss
RuntimeDirectoryMode=0755
# 1280×720@30 + 2 Mbps：异步 16 URB，单路约 1.3 核 python + 0.3 核 ffmpeg；
# Fn 单击切眼镜预览（10 fps，双路约 1.1 + 0.23 核），长按停/恢复 RTSP。
# 需要 640×480 时改 --size 640x480（并删掉 --async-urb/frame-index 相关参数）。
ExecStart=/usr/bin/python3 /home/taco/glxss3-linux/pi/stream.py \
    --rtsp rtsp://127.0.0.1:8554/glxss \
    --size 1280x720 \
    --fps 30 \
    --bitrate 2M \
    --async-urb 16 \
    --mirror-fps 10 \
    --mirror-rotate 180 \
    --preview-fps 10 \
    --codec h264_v4l2m2m \
    --transport tcp
Restart=always
RestartSec=5
TimeoutStopSec=10
# 只允许它读写 USB/视频设备，其余保持默认
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
