# 原始第三方文件（禁止入库）
*.apk
*.aab
*.img
*.so
*.dex
apk/
jadx-*/
native/
firmware/

# 构建/临时
__pycache__/
*.pyc
.venv/
venv/
*.log
*.tar
*.tar.gz
*.zip
*.bundle

# 编辑器
.idea/
.vscode/
.DS_Store
Thumbs.db

# Android / Gradle
app/.gradle/
app/build/
app/local.properties
app/.idea/
*.keystore
*.jks
app/app/build/

# 自研 APK 分发（允许入库）
!dist/*.apk

# APK 内置固件（0.1.5 起随 APK 分发，版权归亮亮视野，仅用于互操作性恢复，见 NOTICE.md）
# 注意：上面的 `*.img` / `firmware/` 会命中这个目录，必须显式取消忽略
!app/app/src/main/assets/firmware/
!app/app/src/main/assets/firmware/*
